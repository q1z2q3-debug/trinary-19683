{
  "work": "补天者",
  "author": "原创（本体系首次自写自诊）",
  "criterion": "C-普世标准 v1",
  "exempt": {},
  "scenes": [
    {
      "id": "S01",
      "name": "天裂·屠户的谎",
      "u": "DDD",
      "m": "DDD",
      "l": "DTD",
      "ev": [
        "瓦上的裂缝是第一次出现",
        "日光漏下秩序开始漏",
        "缝一上午宽了一指",
        "无人抬头应对",
        "人群绕开那道白线走",
        "无人有处置的路径",
        "没人觉得这件事重要",
        "瓦缝漏光的实感",
        "集市照旧喧闹"
      ]
    },
    {
      "id": "S02",
      "name": "承缝·交下骨锥",
      "u": "RRR",
      "m": "TRR",
      "l": "TTD",
      "ev": [
        "承缝是传了七代的规矩",
        "骨锥是唯一能用的东西",
        "上山的路只有一条",
        "他当场决定接下来",
        "与父辈之间一脉相承",
        "爬屋脊的路径已熟",
        "这事总得有人去做",
        "骨锥握在手里的实感",
        "他身骨单薄"
      ]
    },
    {
      "id": "S03",
      "name": "第一次补·左手小指",
      "u": "RRT",
      "m": "TDT",
      "l": "TTD",
      "ev": [
        "裂缝的形状有它的走向",
        "左手小指是能拿出的代价",
        "缝合上了，天不再漏",
        "他把指节往里推",
        "四周没有一个人帮他",
        "补成了这一处",
        "补天这件事有价值",
        "血顺着手腕流下来的实感",
        "他从屋脊下来矮了一寸"
      ]
    },
    {
      "id": "S04",
      "name": "补过的地方没人记得",
      "u": "DRR",
      "m": "DDR",
      "l": "DTR",
      "ev": [
        "天不认名字只认骨头",
        "他还剩一副身体可用",
        "日子照旧过下去",
        "他无从主张这件事",
        "没有人认得他补过",
        "他回家去的路照旧",
        "这件事的意义被抹掉",
        "吆喝声穿过人群的实感",
        "安顿下来吃了饭"
      ]
    },
    {
      "id": "S05",
      "name": "契约之裂·虚言换了衣服",
      "u": "DDD",
      "m": "DDD",
      "l": "DTD",
      "ev": [
        "契约的形式给谎穿上了衣",
        "标的物到底是什么无人说得清",
        "缝比上一回宽了三倍",
        "他站在那里无话可说",
        "商人与买主各说各话",
        "已经无路可走",
        "意义在这句话里崩了",
        "墨迹里裂开一道缝",
        "人潮继续涌动"
      ]
    },
    {
      "id": "S06",
      "name": "取肋骨·绕过舍不得",
      "u": "RRT",
      "m": "TTT",
      "l": "TTD",
      "ev": [
        "取骨有取骨的规矩",
        "肋骨比小指要难得多",
        "这一处又补上了",
        "他躺上门板自己开口",
        "妻子持锥守在一旁",
        "绕过一层看不见的东西补成",
        "补天仍然有意义",
        "骨与肉分离的实感",
        "他又矮下去一寸"
      ]
    },
    {
      "id": "S07",
      "name": "一句谎·自家的房梁",
      "u": "DDD",
      "m": "DTD",
      "l": "TTD",
      "ev": [
        "他自己把规矩破了",
        "真的一无所有",
        "房梁当夜就裂开",
        "他为了安慰孩子说了谎",
        "孩子抬头看他的眼睛",
        "他无处可去",
        "「因为天越来越高」",
        "孩子当场就信了",
        "自家的屋顶漏了"
      ]
    },
    {
      "id": "S08",
      "name": "天裂成网·数到九千",
      "u": "DDD",
      "m": "TDD",
      "l": "TTD",
      "ev": [
        "裂缝不再是一道一道了",
        "一张网罩下来",
        "一路往下走",
        "他决定动用脊骨",
        "独自站在网下",
        "已经无处可走",
        "数到第九千道便不数了",
        "网下站了一整夜的实感",
        "身体已经撑不住"
      ]
    },
    {
      "id": "S09",
      "name": "成人柱·把我竖起来",
      "u": "TTT",
      "m": "TTR",
      "l": "TTD",
      "ev": [
        "他越过了人身这条线",
        "脊骨是最后一笔本钱",
        "天被撑住了",
        "他下令把我竖起来",
        "众人抬他上最高的山",
        "他成了一根柱子",
        "撑天成了他此生的意义",
        "脊骨自己裂开的实感",
        "身体彻底毁了"
      ]
    },
    {
      "id": "S10",
      "name": "柱下许愿·他张开嘴",
      "u": "DDD",
      "m": "TDD",
      "l": "TTD",
      "ev": [
        "许愿的虚言让天重新裂",
        "一切又漏了",
        "天上又开始漏光",
        "他选择张开嘴笑",
        "人与柱之间不再相连",
        "已经无路可走",
        "笑成了他最后的意义",
        "裂缝顺着他的脸走一圈",
        "气终于吐了出来"
      ]
    }
  ]
}